<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Location for weather and maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- Media permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- For older Android versions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    
    <!-- Foreground service for export -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Vibration for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Biometric -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".DairumApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dairum"
        tools:targetApi="34">

        <!-- Main Activity -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Dairum.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- File Provider for sharing media -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY" />
        
        <!-- Automation Receiver for Tasker/MacroDroid integration (legacy intent-based) -->
        <receiver
            android:name=".receiver.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dairum.action.EXPORT" />
                <action android:name="com.dairum.action.BACKUP" />
            </intent-filter>
        </receiver>
        
        <!-- Tasker/Locale/MacroDroid Plugin Edit Activity (UI-based configuration) -->
        <activity
            android:name=".plugin.PluginEditActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Dairum Action"
            android:theme="@style/Theme.Dairum">
            <!-- Tasker Plugin Category -->
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
            <!-- MacroDroid Plugin Category -->
            <intent-filter>
                <action android:name="com.arlosoft.macrodroid.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        
        <!-- Tasker/Locale/MacroDroid Plugin Fire Receiver -->
        <receiver
            android:name=".plugin.PluginFireReceiver"
            android:exported="true">
            <!-- Tasker Fire Action -->
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
            <!-- MacroDroid Fire Action -->
            <intent-filter>
                <action android:name="com.arlosoft.macrodroid.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>
        
        <!-- Quick Entry Widget -->
        <receiver
            android:name=".widget.QuickEntryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.dairum.widget.REFRESH_PROMPT" />
                <action android:name="com.dairum.widget.NEW_ENTRY" />
                <action android:name="com.dairum.widget.NEW_ENTRY_WITH_PROMPT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_entry_info" />
        </receiver>
        
        <!-- Stats Widget -->
        <receiver
            android:name=".widget.StatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stats_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.dairum.widget.OPEN_STATS" />
                <action android:name="com.dairum.widget.OPEN_APP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        
        <!-- Mood Widget -->
        <receiver
            android:name=".widget.MoodWidgetProvider"
            android:exported="true"
            android:label="@string/widget_mood_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.dairum.widget.LOG_MOOD" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mood_info" />
        </receiver>
        
        <!-- Today Widget -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.dairum.widget.TODAY_NEW_ENTRY" />
                <action android:name="com.dairum.widget.TODAY_OPEN_APP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

    </application>

</manifest>
